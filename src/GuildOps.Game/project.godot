; Engine configuration file.
config_version=5

[application]

config/name="GuildOps"
config/description="Jeu de gestion de guilde fantasy, 100 % hors ligne et silencieux (Godot 4.7.2 .NET)."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Compatibility")
config/icon="res://Assets/b5_3/branding/app_icon_256.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.11, 0.08, 0.18, 1)

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="GuildOps.Game"

[rendering]

textures/canvas_textures/default_texture_filter=0

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
