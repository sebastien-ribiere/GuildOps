    "corvee": {
      "rewardCopperMin": 2,
      "rewardCopperMax": 10,
      "energyCostMin": 10,
      "energyCostMax": 15,
      "levelMin": 1,
      "levelMax": 2,
      "riskPenaltyPp": 0,
      "waiveHeroEngagementCost": true
    },
    "village": {
      "rewardCopperMin": 20,
      "rewardCopperMax": 70,
      "energyCostMin": 15,
      "energyCostMax": 25,
      "levelMin": 1,
      "levelMax": 3,
      "riskPenaltyPp": 8,
      "waiveHeroEngagementCost": false
    },
    "aventure": {
      "rewardCopperMin": 80,
      "rewardCopperMax": 200,
      "energyCostMin": 20,
      "energyCostMax": 35,
      "levelMin": 2,
      "levelMax": 4,
      "riskPenaltyPp": 18,
      "waiveHeroEngagementCost": false
    },
    "notable": {
      "rewardCopperMin": 250,
      "rewardCopperMax": 600,
      "energyCostMin": 30,
      "energyCostMax": 45,
      "levelMin": 3,
      "levelMax": 4,
      "riskPenaltyPp": 28,
      "waiveHeroEngagementCost": false
    },
    "royale": {
      "rewardCopperMin": 800,
      "rewardCopperMax": 1800,
      "energyCostMin": 40,
      "energyCostMax": 60,
      "levelMin": 4,
      "levelMax": 5,
      "riskPenaltyPp": 38,
      "waiveHeroEngagementCost": false
    }
  },
  "missionResolution": {
    "formula": "clamp(baseSuccessPercent - category.riskPenaltyPp + levelBonusPerAdditionalLevelPp*(hero.level - quest.minLevel) + traitSuccessModifierPp - (energyBefore < lowEnergyMultiple * quest.energyCost ? lowEnergyPenaltyPp : 0), minSuccessPercent, maxSuccessPercent)",
    "baseSuccessPercent": 85,
    "levelBonusPerAdditionalLevelPp": 5,
    "lowEnergyMultiple": 2,
    "lowEnergyPenaltyPp": 5,
    "minSuccessPercent": 15,
    "maxSuccessPercent": 95,
    "rollDomain": "integer 0..99",
    "isSuccess": "roll < computedSuccessPercent",
    "consumesEnergyOnSuccessAndFailure": true,
    "consumesRewardOnlyOnSuccess": true,
    "levelBelowMinimumRejectsAssignment": true,
    "energyEqualToCostIsEnough": true,
    "treasuryEqualToCostIsEnough": true,
    "invalidCommandMutatesNothing": true,
    "duplicateResolutionMustNotMutateAnything": true
  },
  "complaints": {
    "onlyWhenActualIncident": true,
    "atMostOnePendingIncidentPerMission": true,
    "alternatives": [
      {
        "id": "repair",
        "description": "payer le dédommagement fixe de l'incident",
        "defaultIllustrativeCostCopper": 80,
        "reputationDelta": 3,
        "requiresSufficientTreasury": true
      },
      {
        "id": "apologize",
        "description": "présenter des excuses et reconnaître la faute",
        "costCopper": 0,
        "reputationDelta": 1
      },
      {
        "id": "deny",
        "description": "refuser la réclamation",
        "costCopper": 0,
        "reputationDelta": -2
      }
    ],
    "noCompensationWithoutIncident": true,
    "incidentResolvedAtMostOnce": true
  },
  "narrative": {
    "maxStoryletsPerMission": 1,
    "storyletsForInitialSlice": 2,
    "storyletsForV0": 8,
    "storyletsConditionalAndDataDriven": true,
    "contentIsLocal": true
  },
  "rng": {
    "injectable": true,
    "deterministicOnSameVersionAndSeed": true,
    "testSeed": 1142026,
    "selectionOrder": "stable_by_id",
    "rerollCannotBeTriggeredByUIRefresh": true
  },
  "performance": {
    "catalogueSizesForBenchmark": [
      100,
      1000,
      10000
    ],
    "sameSeedAndDatasetForBeforeAfter": true
  },
  "sourceOfTruth": "game-data/rules.v0.1.json; tests contractuels reflètent ce fichier. Ne pas dupliquer les seuils réels dans les scènes."
