    "categories": [
      "corvee",
      "village",
      "aventure",
      "notable",
      "royale"
    ],
    "guaranteedRecoveryOffer": {
      "when": "reputation < 40 OR treasuryCopper < cheapestEligibleHeroBaseCost",
      "countWithinFour": 1,
      "templateId": "promener-medor",
      "heroEngagementCostCopper": 0,
      "questEnergyCost": 10,
      "questMinLevel": 1,
      "questRewardCopper": 2,
      "questRiskPenaltyPercentagePoints": 0,
      "skill": "exploration",
      "successReputationDelta": 2
    },
    "offerMustBeEligibleForAtLeastOneHero": true,
    "doNotRegenerateOffersOnRead": true
