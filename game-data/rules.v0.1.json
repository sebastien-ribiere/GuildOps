      "minimumSucceededMissions": 8,
      "check": "after_day_7"
    },
    "earlyGameOver": false,
    "resetAvailable": true
  },
  "reputation": {
    "min": 0,
    "max": 100,
    "tiers": [
      {
        "id": "paria",
        "min": 0,
        "max": 19
      },
      {
        "id": "suspecte",
        "min": 20,
        "max": 39
      },
      {
